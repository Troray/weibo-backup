# ==========================================
# Weibo 爬虫系统全局配置文件模板 (.env.example)
# ==========================================
# 说明：请将此文件复制为 .env 文件，并根据你的实际需求修改其中的配置。
# 提示：所有布尔值（Boolean）只能填写 true 或 false。

# ------------------------------------------
# 1. 目标账号配置 (Target accounts)
# ------------------------------------------
# 需要爬取的目标账号。支持三种配置方式：
#   ① 单个用户 UID，例如：USER_ID_LIST=6634214154
#   ② 多个用户 UID（英文逗号分隔），例如：USER_ID_LIST=6634214154,2902408801
#   ③ 本地游标文本文件，例如：USER_ID_LIST=userid.txt（以 .txt 结尾，程序会自动增量记录每次的结束时间作为下次的起点）
USER_ID_LIST=userid.txt

# ------------------------------------------
# 2. 抓取时间跨度限制 (Date range filtering)
# ------------------------------------------
# 抓取的起始日期（包含当天，格式：YYYY-MM-DD）。
# 仅配置开始日期时，爬虫采用【增量/时间搜索模式】升序抓取从该日期至当前当天的所有微博；如果不配置开始日期，则采用默认的【主页 Feed 模式】进行抓取。
# 结束日期可选。如果配置了开始日期而未配置结束日期，默认将自动以“当天日期”作为结束日期。
# START_DATE=2026-01-01
# END_DATE=2026-07-01

# ------------------------------------------
# 3. 登录与安全配置 (Login and security settings)
# ------------------------------------------
# 微博账号登录策略模式。支持以下三种模式：
#   - TERMINAL_QR：终端扫码模式。程序将直接请求官方接口获取登录二维码并将其转换为 ASCII 字符画在终端打印，方便服务器环境下直接扫码登录。
#   - BOT_NOTIFY：机器人推送扫码。二维码图片将通过 Telegram 机器人推送到绑定的账号上进行扫码。
#   - LOCAL_SYNC：本地会话凭证同步。直接复用本地导出的 state.json 文件，不再执行主动扫码校验。
LOGIN_MODE=TERMINAL_QR

# 登录会话凭证（Cookie/LocalStorage等）的保存路径，用于免密复用会话。
STATE_FILE=state.json

# 微博登录态持久化记住天数（对应新浪通行证 SSO savestate 参数，默认为 30 天，可设置为 30 / 180 等）
# WEIBO_SAVESTATE=30

# 扫码等待授权超时时间（支持如 5m、300s 或毫秒，默认 5m）
# LOGIN_QR_TIMEOUT=5m

# 是否开启自动续期与心跳检查（默认 true）
# WEIBO_SESSION_REFRESH_ENABLED=true

# 守护进程模式下自动续期检查间隔（支持如 12h、6h 等，默认 12h）
# WEIBO_SESSION_REFRESH_INTERVAL=12h

# ------------------------------------------
# 4. 机器人与通知配置 (Bot and Notification - Optional)
# ------------------------------------------
# 守护进程模式（在部署到 VPS 时，开启后可保持 Telegram 交互式机器人运行，接收各种交互指令）
DAEMON_MODE=false

# 定时自动爬取时间（仅在 DAEMON_MODE=true 时有效。格式为北京时间的 HH:MM，支持英文逗号分隔的多个时间，如 00:30,12:00,18:30。留空则表示不启用定时自动爬取）
# SCHEDULE_CRAWL_TIME=00:30

# Telegram 机器人通知与交互配置
# TELEGRAM_BOT_TOKEN=你的Telegram机器人Token
# TELEGRAM_CHAT_ID=你的Telegram聊天ID
# TELEGRAM_API_BASE=Telegram API 反代地址 (可选，国内环境可配置为反代地址以防网络连接超时)
# HTTP_PROXY=网络代理地址 (可选，国内环境配置此项以使机器人及通知的所有请求走代理，例如 http://127.0.0.1:7890)

# 钉钉机器人 Webhook (可选)
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=签名校验密钥(如有)

# 企业微信群机器人 Webhook (可选)
# WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 飞书机器人 Webhook (可选)
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v3/hook/xxx
# FEISHU_SECRET=签名校验密钥(如有)

# Lark (飞书国际版) 机器人 Webhook (可选)
# LARK_WEBHOOK=https://open.larksuite.com/open-apis/bot/v3/hook/xxx
# LARK_SECRET=签名校验密钥(如有)

# ------------------------------------------
# 5. 抓取行为控制规则 (Scraping control rules)
# ------------------------------------------
# 是否仅仅抓取原创微博（如果设置为 true，将主动过滤并排除博主的所有转发微博）。
ONLY_ORIGINAL=false

# 是否抓取微博评论区。
SCRAPE_COMMENTS=false

# 单条微博下最大允许爬取的评论总数。
# 设置为 50 则每条微博最多爬取 50 条评论；设置为 0 或负数则代表无上限，即爬取该微博底部的【全部评论】。
MAX_COMMENTS_PER_POST=50

# 评论排序抓取模式。
# 0 = 按热度排序（默认推荐，可完整获取全部热门评论，避免大V/明星博主因时间线过滤截断导致只抓到几条评论）。
# 1 = 按时间排序。在热度模式下，若未达到抓取上限，系统还会自动衔接时间线补全更多评论。
COMMENT_FLOW=0

# 单条主评论最大抓取楼中楼（二级回复/子评论）数量。
# 大V微博成千上万条评论绝大多数集中在热门评论的楼中楼回复中。默认 50 条，填 0 则跟随主评论上限尽量深入抓取。
MAX_SUB_COMMENTS_PER_COMMENT=50

# 评论海量分批流式落盘与断点暂存阈值（默认 200）。
# 当目标微博评论数达到此阈值时，自动启用安全策略：优先将博文正文及超清视频/图片安全落盘，并对后续耗时的评论抓取启用分批断点暂存（每 100 条刷盘防丢失，支持断点续爬与 Ctrl+C 抢救落盘）；
# 低于此阈值时则保持原生一次性快速落盘。填 0 则禁用该机制。
COMMENT_CHUNKING_THRESHOLD=200

# 防防爬机制：请求评论 API 时的随机等待延迟下限（毫秒）。
REQUEST_DELAY_MIN=1500
# 防防爬机制：请求评论 API 时的随机等待延迟上限（毫秒）。
REQUEST_DELAY_MAX=3000

# ------------------------------------------
# 6. 多媒体下载控制开关 (Media download settings)
# ------------------------------------------
# 是否下载原创微博中的高清大图（true = 启用，false = 禁用）。
DOWNLOAD_ORIGINAL_IMAGES=true

# 是否下载原创微博中的超清原画视频（true = 启用，false = 禁用）。
DOWNLOAD_ORIGINAL_VIDEOS=true

# 是否下载原创微博中的 Live Photo 实况照片（true = 启用，false = 禁用）。
DOWNLOAD_ORIGINAL_LIVEPHOTOS=true

# 是否下载原创微博中的语音/音频文件（true = 启用，false = 禁用）。
DOWNLOAD_ORIGINAL_AUDIOS=true

# 是否下载转发微博中携带的媒体图片（true = 启用，false = 禁用）。
DOWNLOAD_RETWEET_IMAGES=false

# 是否下载转发微博中携带的视频（true = 启用，false = 禁用）。
DOWNLOAD_RETWEET_VIDEOS=false

# 是否下载转发微博中携带的 Live Photo 实况照片（true = 启用，false = 禁用）。
DOWNLOAD_RETWEET_LIVEPHOTOS=false

# 是否下载转发微博中携带的语音/音频文件（true = 启用，false = 禁用）。
DOWNLOAD_RETWEET_AUDIOS=false

# 是否下载评论区内容中用户附带的媒体文件（true = 启用，false = 禁用）。
DOWNLOAD_COMMENT_MEDIA=false

# 媒体文件异步下载的并发上限。数字越大下载越快，但对网络要求更高，默认推荐为 10。
CONCURRENT_DOWNLOADS=10

# ------------------------------------------
# 7. 数据持久化输出配置 (Data export formats)
# ------------------------------------------
# 爬取结果（图片、视频、Markdown、JSON、CSV）的根输出文件夹。
# 支持相对路径（如 ./output）与绝对路径（如 /opt/weibo_data），在 Windows/Linux 下均可跨平台兼容。
OUTPUT_DIR=./output

# 需要保存的本地文件格式类型列表，用英文逗号分隔。不填表示不保存任何本地文件格式。
# 支持以下三种类型：
#   - csv      ：按年月归档生成流式追加 of posts.csv 数据表
#   - json     ：在对应的年月目录内生成每条微博的原始结构化 JSON 备份文件
#   - markdown ：按年月归档生成以天为单位（YYYY-MM-DD.md）的 Markdown 备份，内部包含本地媒体相对路径与层级评论
SAVE_TYPES=csv,json,markdown

# ------------------------------------------
# 8. 数据库持久化配置 (Database storage connection)
# ------------------------------------------
# 支持的关系型数据库类型。可选值：sqlite, mysql, postgres
# 留空则表示不配置数据库
DB_TYPE=

# 数据库连接目标配置。
# - 如果是 SQLite：请填写本地文件路径（例如 weibo.sqlite），程序会自动创建并连接该数据库。
# - 如果是 MySQL/PostgreSQL：请填写标准连接 URI，如 mysql://user:pass@localhost:3306/db
#   * 注意：如果从云厂商（如 Aiven, TiDB, AWS RDS）复制连接串并带有 ?ssl-mode=REQUIRED 参数，
#     程序会自动识别并兼容清洗，无需担心触发底层驱动关于 ssl-mode 的配置警告。
DB_URI=weibo.sqlite

# 可选：云数据库自签名或特定 SSL CA 证书文件路径（例如 Aiven 控制台下载的 ca.pem）。留空则按默认连接。
# DB_SSL_CA=./ca.pem

# 可选：是否严格校验 SSL 证书合法性（默认 false，可直接兼容云数据库如 Aiven/Supabase 自签名证书链；设为 true 则严格校验证书）。
# DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------
# 9. 任务后置扩展脚本 (Post-task hook script)
# ------------------------------------------
# 任务结束（增量同步/定时爬取/定向抓取）后调用的外部脚本或命令。
# 支持 .py / .sh / .ps1 / .bat 脚本路径或完整命令行指令（例如 rclone 同步、网盘上传脚本等）。留空表示不执行。
# 支持相对路径（相对于项目根目录，例如 scripts/post_hook_example.py）或系统绝对路径。
# 示例：
#   POST_SCRIPT_COMMAND=scripts/post_hook_example.py
#   POST_SCRIPT_COMMAND=python3 /opt/scripts/sync_to_nas.py
#   POST_SCRIPT_COMMAND=bash /opt/scripts/backup.sh
#   POST_SCRIPT_COMMAND=rclone copy ./output onedrive:/weibo-backup
# POST_SCRIPT_COMMAND=

# 触发策略条件。支持以下 4 种策略模式：
#   - has_new_data ：（默认推荐）仅当本次爬取成功且发现有新增微博或媒体下载时触发执行。
#   - success      ：只要爬虫成功运行完毕即触发，无论是否有新增内容。
#   - always       ：无论爬虫运行成功还是发生异常/会话过期，结束后均无条件触发（适合运维监控告警）。
#   - failure      ：仅在爬取过程发生异常或登录会话过期时触发（适合异常报警与自动重连脚本）。
# POST_SCRIPT_TRIGGER=has_new_data

# 执行模式：是否等待脚本执行完毕再推送最终通知报告（默认 true）。
#   - true  ：同步等待脚本运行，自动收集脚本执行结果与摘要信息，合并追加至 Telegram/CLI 最终报告。
#   - false ：异步后台分离拉起（detached），爬虫进程不等待脚本执行，直接发送抓取报告后释放资源。
# POST_SCRIPT_WAIT=true

# 同步等待模式下的最长执行超时时间。支持单位：s (秒), m (分), h (小时), ms (毫秒)；默认 10m (10分钟)。
# 若脚本执行超时，爬虫系统将发送 SIGTERM 并在优雅超时后递归强制终止进程树，绝不影响已保存的游标与数据。
# POST_SCRIPT_TIMEOUT=10m

# 外部脚本是否继承当前爬虫系统的 HTTP 代理环境变量 (HTTP_PROXY / HTTPS_PROXY / ALL_PROXY)。
# 默认 false：默认剥离代理变量，防止本地 NAS/内网 WebDAV/局域网 Alist 同步脚本误走外部翻墙代理导致网络超时或死锁。
# 若设为 true，外部脚本将完整继承主程序的代理配置（适用于同步至海外网盘如 Google Drive / OneDrive 的场景）。
# POST_SCRIPT_INHERIT_PROXY=false

